{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/api-case-v1.schema.json",
  "title": "API Automation Case DSL v1",
  "type": "object",
  "required": ["dslVersion", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "dslVersion": { "const": "v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "variables": {
      "type": "object",
      "additionalProperties": true
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/httpStep" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string" },
        "profile": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "senderPublicKey": { "type": "string" },
        "senderPrivateKey": { "type": "string" },
        "senderPrivateKeyPassphrase": { "type": "string" },
        "recipientPublicKey": { "type": "string" },
        "recipientPrivateKey": { "type": "string" },
        "recipientPrivateKeyPassphrase": { "type": "string" }
      }
    },
    "httpStep": {
      "type": "object",
      "required": ["name", "type", "operation", "request", "actions", "response"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "http" },
        "operation": { "$ref": "#/$defs/operation" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "request": { "$ref": "#/$defs/request" },
        "actions": { "$ref": "#/$defs/actionPipeline" },
        "response": { "$ref": "#/$defs/response" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "apiSpecId": { "type": "string" },
        "apiSpecName": { "type": "string" },
        "operationId": { "type": "string" },
        "summary": { "type": "string" },
        "service": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "query": {
          "type": "object",
          "additionalProperties": true
        },
        "body": true
      }
    },
    "actionPipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeSend": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/signAndEncryptAction" },
              { "$ref": "#/$defs/encodeBase64Action" },
              { "$ref": "#/$defs/buildJsonAction" }
            ]
          }
        },
        "afterReceive": {
          "type": "array",
          "items": { "$ref": "#/$defs/decryptAndVerifyAction" }
        }
      }
    },
    "signAndEncryptAction": {
      "type": "object",
      "required": ["type", "input", "output"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "crypto.pgp.signAndEncrypt" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "input": { "$ref": "#/$defs/actionInput" },
        "output": { "$ref": "#/$defs/actionOutput" }
      }
    },
    "encodeBase64Action": {
      "type": "object",
      "required": ["type", "input", "output"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "data.encodeBase64" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "input": { "$ref": "#/$defs/actionInput" },
        "output": { "$ref": "#/$defs/actionOutput" }
      }
    },
    "buildJsonAction": {
      "type": "object",
      "required": ["type", "template", "output"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "body.buildJson" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "template": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" }
          ]
        },
        "output": { "$ref": "#/$defs/actionOutput" }
      }
    },
    "decryptAndVerifyAction": {
      "type": "object",
      "required": ["type", "input", "output"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "crypto.pgp.decryptAndVerify" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "input": { "$ref": "#/$defs/actionInput" },
        "output": { "$ref": "#/$defs/actionOutput" }
      }
    },
    "actionInput": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "format": { "enum": ["json", "text", "xml"] }
      }
    },
    "actionOutput": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "format": { "enum": ["json", "text", "xml"] }
      }
    },
    "response": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" }
        },
        "extract": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/extractValue" }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["source", "path", "operator"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": ["equals", "notEquals", "exists", "notExists", "contains", "greaterThan", "lessThan"]
        },
        "expected": true
      }
    },
    "extractValue": {
      "type": "object",
      "required": ["source", "path"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
